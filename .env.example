# NEIS 오픈 API 인증키 (https://open.neis.go.kr) — 실제 값은 .env.local과 Vercel 설정에만 넣는다
NEIS_API_KEY=
# 대전고 표준학교코드 (비밀 아님). 비워두면 "대전고등학교"로 자동 조회
NEIS_SCHOOL_CODE=7430031
# (선택) 시도교육청코드. 기본 G10(대전)
NEIS_OFFICE_CODE=G10
# Supabase (Project Settings → API). 둘 다 브라우저에 공개돼도 되는 값 — RLS가 지킨다.
# secret / service_role 키는 여기에 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
